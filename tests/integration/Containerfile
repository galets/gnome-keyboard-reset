ARG BASE_IMAGE=fedora:41
FROM ${BASE_IMAGE}

RUN dnf install -y \
        systemd \
        gnome-shell \
        dbus-daemon \
        glib2 \
        make \
        mesa-dri-drivers \
        mesa-libEGL \
        dconf \
        pipewire \
    && dnf clean all

WORKDIR /workspace
COPY . .

RUN chmod +x tests/integration/smoke-test.sh

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
